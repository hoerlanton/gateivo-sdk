{
  "name": "@gateivo/sdk",
  "version": "0.1.0-preview.7",
  "private": true,
  "description": "Expose selected read-only backend functions as authenticated MCP tools for AI assistants",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./oauth": {
      "import": {
        "types": "./dist/oauth.d.ts",
        "default": "./dist/oauth.js"
      },
      "require": {
        "types": "./dist/oauth.d.cts",
        "default": "./dist/oauth.cjs"
      }
    },
    "./workos-connect": {
      "import": {
        "types": "./dist/workos-connect.d.ts",
        "default": "./dist/workos-connect.js"
      },
      "require": {
        "types": "./dist/workos-connect.d.cts",
        "default": "./dist/workos-connect.cjs"
      }
    },
    "./workos-connect/express": {
      "import": {
        "types": "./dist/workos-connect-express.d.ts",
        "default": "./dist/workos-connect-express.js"
      },
      "require": {
        "types": "./dist/workos-connect-express.d.cts",
        "default": "./dist/workos-connect-express.cjs"
      }
    },
    "./workos-connect/postgres": {
      "import": {
        "types": "./dist/workos-connect-postgres.d.ts",
        "default": "./dist/workos-connect-postgres.js"
      },
      "require": {
        "types": "./dist/workos-connect-postgres.d.cts",
        "default": "./dist/workos-connect-postgres.cjs"
      }
    },
    "./login/express": {
      "import": {
        "types": "./dist/login-express.d.ts",
        "default": "./dist/login-express.js"
      },
      "require": {
        "types": "./dist/login-express.d.cts",
        "default": "./dist/login-express.cjs"
      }
    },
    "./login/postgres": {
      "import": {
        "types": "./dist/login-postgres.d.ts",
        "default": "./dist/login-postgres.js"
      },
      "require": {
        "types": "./dist/login-postgres.d.cts",
        "default": "./dist/login-postgres.cjs"
      }
    },
    "./workos-connect/standalone": {
      "import": {
        "types": "./dist/workos-standalone.d.ts",
        "default": "./dist/workos-standalone.js"
      },
      "require": {
        "types": "./dist/workos-standalone.d.cts",
        "default": "./dist/workos-standalone.cjs"
      }
    },
    "./workos-connect/password": {
      "import": {
        "types": "./dist/workos-password.d.ts",
        "default": "./dist/workos-password.js"
      },
      "require": {
        "types": "./dist/workos-password.d.cts",
        "default": "./dist/workos-password.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/authentication.md",
    "docs/workos-connection.md",
    "docs/workos-reference.md",
    "docs/password-login.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.6.0 <23 || 24.x"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/express": "4.17.25",
    "@types/express-serve-static-core": "4.19.9",
    "express": "4.22.3",
    "jose": "6.2.12",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoerlanton/gateivo-sdk.git"
  },
  "homepage": "https://gateivo.com",
  "bugs": {
    "url": "https://github.com/hoerlanton/gateivo-sdk/issues"
  },
  "scripts": {
    "build": "node scripts/build-sdk.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:consumer",
    "pack:preview": "npm run build && node scripts/pack-preview.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:server": "node examples/workouts/server.mjs --demo",
    "demo:client": "node examples/workouts/client.mjs",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:workos": "node --import tsx --test tests/workos-reference*.test.*",
    "verify:workos": "node scripts/verify-workos-reference.mjs",
    "verify:workos:postgres": "node scripts/verify-workos-reference.mjs --postgres",
    "reference:setup": "node examples/workos-reference/setup.mjs",
    "reference:start": "node examples/workos-reference/host.mjs",
    "test:login": "node --import tsx --test tests/login*.test.* tests/workos-standalone*.test.*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "pg": "8.16.3"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}

# Copy to the repository root as .env, keep it private, and replace placeholders.
# Never commit the resulting file or paste keys into issues or chats.
GATEIVO_REFERENCE_CONFIG=/absolute/private/reference/config.json
WORKOS_API_KEY=REPLACE_WITH_YOUR_WORKOS_DEVELOPMENT_API_KEY

# Only when setup used --transport tls:
# GATEIVO_REFERENCE_TLS_CERT_FILE=/absolute/path/to/certificate-chain.pem
# GATEIVO_REFERENCE_TLS_KEY_FILE=/absolute/private/path/to/server-key.pem
